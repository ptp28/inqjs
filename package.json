{
  "name": "inqjs",
  "version": "2.0",
  "description": "A lightweight, dependency-free LINQ engine for TypeScript and JavaScript with comprehensive query capabilities",
  "main": "dist/Query.js",
  "types": "dist/Query.d.ts",
  "exports": {
    ".": {
      "types": "./dist/Query.d.ts",
      "require": "./dist/Query.js",
      "default": "./dist/Query.js"
    },
    "./async": {
      "types": "./dist/async/AsyncQuery.d.ts",
      "require": "./dist/async/AsyncQuery.js",
      "default": "./dist/async/AsyncQuery.js"
    },
    "./json": {
      "types": "./dist/json/fromJson.d.ts",
      "require": "./dist/json/fromJson.js",
      "default": "./dist/json/fromJson.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && vitest run && node tests/query.test.js",
    "test:unit": "vitest run",
    "test:js": "npm run build && node tests/query.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "linq",
    "query",
    "typescript",
    "javascript",
    "functional",
    "lazy-evaluation",
    "async",
    "json",
    "set-operations"
  ],
  "author": "Parth Parikh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ptp28/inqjs.git"
  },
  "bugs": {
    "url": "https://github.com/ptp28/inqjs/issues"
  },
  "homepage": "https://github.com/ptp28/inqjs#readme",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
